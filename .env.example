# env.example — nunca commitar valores reais

# === Servidor ===
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# === Banco de dados (PostgreSQL) ===
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hudplay

# === Autenticação JWT ===
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=altere_este_secret_antes_de_produzir
JWT_REFRESH_SECRET=altere_este_secret_antes_de_produzir
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# === CORS ===
# Lista separada por vírgula de origens permitidas. Use "*" apenas em dev.
ALLOWED_ORIGINS=http://localhost:5173

# === Pagamentos PIX ===
# Provedor ativo: manual (confirmação pelo proprietário) | futuramente: bank_api
PIX_PROVIDER=manual
# Chave PIX padrão para demonstração (sobrescrita pelo painel)
PIX_DEFAULT_KEY=
PIX_DEFAULT_KEY_TYPE=

# === URLs públicas ===
# URL base usada para montar links de partidas (ex.: https://hudplay.com.br)
PUBLIC_BASE_URL=http://localhost:5173

# === Fidelidade ===
# Ativar sistema de pontos (true/false)
LOYALTY_POINTS_ENABLED=true